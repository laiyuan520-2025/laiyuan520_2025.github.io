            M = year[2:4]
            D = year[0:2]
            print(f"day:{Y}年{M}月{D}日")
            
            la_ds = float(lat[:2])
            la_m = float(lat[2:])
            la_d = la_ds + la_m / 60
            
            lo_ds = float(lon[:3])
            lo_m = float(lon[3:])
            lo_d = lo_ds + lo_m / 60
